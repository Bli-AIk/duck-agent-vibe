# Duck 默认开启变更拦截；主动督导和单步引导仍可分别控制。
enabled = true
guide_enabled = false

# 教学模式默认关闭。开启后可在督导关闭时独立监控项目。
teach_enabled = false
teach_auto_suggest = true
teach_cooldown_ms = 30000
teach_min_change_score = 2
teach_max_queries_per_turn = 3
teach_max_excerpt_chars = 2400
teach_cache_ttl_ms = 600000

debounce_ms = 2000
max_batch_ms = 30000
cooldown_ms = 900000
guide_cooldown_ms = 8000
guide_min_change_score = 2
guide_watch_handoff = false
guide_auto_read_diff = false
large_change_threshold = 12
max_question_context_chars = 6000
max_diff_chars = 6000
keybinding = "ctrl+shift+d"

[reply_shortcuts]
detail = "ctrl+alt+m"
next = "ctrl+alt+n"
hint = "ctrl+alt+h"

# 只读检查可以配置为大变更后的自动诊断。
# [[diagnostics]]
# name = "项目检查"
# command = "npm"
# args = ["test"]
# auto_on_large_change = true

