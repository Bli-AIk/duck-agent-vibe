{
  "name": "duck-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A Pi coding-agent extension that blocks project mutations and asks Socratic questions.",
  "type": "module",
  "files": ["src", "README.md", ".duck.toml.example", "package.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "chokidar": "^4.0.3",
    "smol-toml": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
